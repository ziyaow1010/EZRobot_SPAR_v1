\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{caselab}[2026/10/21 CaseLab Cosmos-style research report]
% CaseLab uses the conventional research-paper hierarchy of the Cosmos 3 report.
% This is a clean adaptation, not an identical proprietary NVIDIA template.
\RequirePackage{fontspec}
\RequirePackage[letterpaper,margin=1in]{geometry}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning}
\RequirePackage{amsmath,amssymb}
\RequirePackage{booktabs,tabularx,array}
\RequirePackage{microtype}
\RequirePackage{enumitem}
\RequirePackage[numbers,sort&compress]{natbib}
\RequirePackage{titlesec}
\RequirePackage{caption}
\RequirePackage{hyperref}
\definecolor{CaseOrange}{HTML}{F36B21}
\definecolor{CaseBlack}{HTML}{171717}
\color{CaseBlack}
% Keep the previously selected retro type family.
\setmainfont{Linux Libertine O}[Ligatures=TeX]
\setsansfont{Linux Libertine Display O}
\setmonofont{Nimbus Mono PS}[Scale=.91]
\newfontfamily\casetype{Nimbus Mono PS}[Scale=.91]
\newcommand{\zyra}{Zyra}
\newcommand{\CaseTitle}{Untitled}
\newcommand{\CaseAuthors}{CaseLab}
\newcommand{\CaseDate}{October 2026}
\newcommand{\CaseNumber}{CL--TR--2026--01}
\newcommand{\CaseShortTitle}{CaseLab Research}
\makeatletter
\renewcommand{\maketitle}{%
\begin{center}
{\fontsize{18}{21}\selectfont\bfseries\@title\par}
\vspace{.85em}
{\normalsize\@author\par}
\vspace{.55em}
{\small\@date\par}
\end{center}
\vspace{.7em}
}
\makeatother
% Cosmos-paper layout: no separate cover, logo bar, decorative rules or TOC.
\pagestyle{plain}
\titleformat{\section}{\normalfont\large\bfseries\color{CaseBlack}}{\textcolor{CaseOrange}{\thesection}}{.7em}{}
\titleformat{\subsection}{\normalfont\normalsize\bfseries\color{CaseBlack}}{\textcolor{CaseOrange}{\thesubsection}}{.7em}{}
\titleformat{\subsubsection}{\normalfont\normalsize\bfseries\color{CaseBlack}}{\thesubsubsection}{.65em}{}
\titlespacing*{\section}{0pt}{1.5ex plus .5ex}{.7ex}
\titlespacing*{\subsection}{0pt}{1.2ex plus .4ex}{.5ex}
\captionsetup{font=small,labelfont=bf,labelsep=period,skip=5pt}
\setlength{\parindent}{1.25em}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{2em}
\setlist[itemize]{leftmargin=*,itemsep=2pt,topsep=4pt}
\hypersetup{colorlinks=true,linkcolor=CaseOrange,citecolor=CaseOrange,urlcolor=CaseOrange}
\renewenvironment{abstract}{%
\begin{center}\bfseries Abstract\end{center}
\begin{list}{}{\leftmargin=1.3em\rightmargin=1.3em}
\item\relax\small\noindent\ignorespaces
}{\end{list}\vspace{.5em}}
