\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{caselab}[2026/10/21 CaseLab Research paper identity]
% Works with pdfLaTeX; no proprietary fonts and no dedicated cover.
\RequirePackage{fontspec}
\RequirePackage[margin=1in,headheight=16pt]{geometry}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning}
\RequirePackage{amsmath,amssymb}
\RequirePackage{booktabs,tabularx,array}
\RequirePackage{microtype}
\RequirePackage{enumitem}
\RequirePackage[numbers,sort&compress]{natbib}
\RequirePackage{titlesec}
\RequirePackage{caption}
\RequirePackage{fancyhdr}
\RequirePackage{hyperref}
\definecolor{CaseRed}{HTML}{B51F32}
\definecolor{CaseBlack}{HTML}{222326}
\definecolor{CaseMuted}{HTML}{66686D}
\color{CaseBlack}
\setmainfont{Linux Libertine O}[Ligatures=TeX]
\setsansfont{Linux Libertine Display O}
\setmonofont{Nimbus Mono PS}[Scale=.91]
\newfontfamily\casetype{Nimbus Mono PS}[Scale=.91]
\newcommand{\CaseTitle}{Untitled}
\newcommand{\CaseAuthors}{CaseLab}
\newcommand{\CaseDate}{October 2026}
\newcommand{\CaseNumber}{CL-TR-2026-01}
\newcommand{\CaseShortTitle}{CaseLab Research}
\newcommand{\CaseBrand}{\textcolor{CaseRed}{\texttt{\textbf{CASELAB}}}}
% Brand is part of the paper's ordinary title block, not a separate title page.
\makeatletter
\renewcommand{\maketitle}{%
\begin{center}
{\fontsize{23}{28}\selectfont\bfseries\color{CaseBlack}\@title\par}
\vspace{.42em}
{\color{CaseRed}\rule{2.1cm}{1.3pt}\par}
\vspace{.85em}
{\normalsize\@author\par}
\vspace{.4em}
{\small\color{CaseMuted}\@date\par}
\end{center}
\vspace{.55em}
}
\makeatother
\pagestyle{fancy}\fancyhf{}
\fancyhead[L]{{\footnotesize\CaseBrand}}
\fancyhead[R]{{\scriptsize\ttfamily\color{CaseMuted}\CaseNumber}}
\fancyfoot[C]{{\small\color{CaseMuted}\thepage}}
\renewcommand{\headrulewidth}{0.85pt}
\renewcommand{\footrulewidth}{0.45pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{CaseRed}\leaders\hrule height \headrulewidth\hfill}}
\renewcommand{\footrule}{\hbox to\headwidth{\color{CaseMuted}\leaders\hrule height \footrulewidth\hfill}}
\titleformat{\section}{\normalfont\large\bfseries\color{CaseBlack}}{\textcolor{CaseRed}{\thesection}}{.75em}{}
\titleformat{\subsection}{\normalfont\normalsize\bfseries\color{CaseBlack}}{\textcolor{CaseRed}{\thesubsection}}{.7em}{}
\titleformat{\subsubsection}{\normalfont\normalsize\itshape\color{CaseBlack}}{\thesubsubsection}{.7em}{}
\titlespacing*{\section}{0pt}{1.6ex plus .7ex}{.7ex}
\titlespacing*{\subsection}{0pt}{1.25ex plus .5ex}{.45ex}
\captionsetup{font=small,labelfont={bf,color=CaseBlack},labelsep=period}
\setlength{\parindent}{1.2em}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{2em}
\setlist[itemize]{leftmargin=*,itemsep=2pt,topsep=4pt}
\hypersetup{colorlinks=true,linkcolor=CaseRed,citecolor=CaseRed,urlcolor=CaseRed,
pdftitle={CaseLab Research Technical Report}}


% CaseLab abstract: quiet archival frame with a signature red spine.
\RequirePackage[most]{tcolorbox}
\tcbset{caselababstract/.style={
 enhanced,breakable,sharp corners,
 colback=white,colframe=CaseMuted!42,
 boxrule=.35pt,leftrule=2.2pt,
 borderline west={2.2pt}{0pt}{CaseRed},
 left=13pt,right=13pt,top=10pt,bottom=11pt,
 before skip=1.1em,after skip=1.15em,
 before upper={\noindent{\casetype\fontsize{9}{11}\selectfont\bfseries\color{CaseRed} ABSTRACT}\par\vspace{7pt}\noindent},
 fontupper=\small
}}
\renewenvironment{abstract}{\begin{tcolorbox}[caselababstract]}{\end{tcolorbox}}
