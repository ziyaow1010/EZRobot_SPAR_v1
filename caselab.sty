\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{caselab}[2026/10/21 CaseLab Research, editorial paper layout]
\RequirePackage{fontspec}
\RequirePackage[letterpaper,top=.86in,bottom=.86in,left=.94in,right=.94in,headheight=17pt,headsep=19pt,footskip=25pt]{geometry}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning}
\RequirePackage{amsmath,amssymb}
\RequirePackage{booktabs,tabularx,array}
\RequirePackage{microtype}
\RequirePackage{enumitem}
\RequirePackage[numbers,sort&compress]{natbib}
\RequirePackage{titlesec}
\RequirePackage{caption}
\RequirePackage{fancyhdr}
\RequirePackage{hyperref}
\RequirePackage[most]{tcolorbox}
\definecolor{CaseRed}{HTML}{AC1932}
\definecolor{CaseBlack}{HTML}{212126}
\definecolor{CaseMuted}{HTML}{58565A}
\color{CaseBlack}
\setmainfont{Linux Libertine O}[Ligatures=TeX]
\setsansfont{Linux Libertine Display O}
\setmonofont{Nimbus Mono PS}[Scale=.90]
\newfontfamily\casetype{Nimbus Mono PS}[Scale=.90]
\newcommand{\zyra}{Zyra}
\newcommand{\CaseTitle}{Untitled}
\newcommand{\CaseAuthors}{CaseLab}
\newcommand{\CaseDate}{October 2026}
\newcommand{\CaseNumber}{CL-TR-2026-01}
\newcommand{\CaseShortTitle}{CaseLab Research}
\newcommand{\CaseBrand}{{\casetype\bfseries\color{CaseRed}CASELAB}}
% Title, author and abstract live on page one: never create a cover page.
\makeatletter
\renewcommand{\maketitle}{%
\begingroup\parindent=0pt
{\raggedright
{\fontsize{25}{27.5}\selectfont\bfseries\color{CaseBlack}\@title\par}
\vspace{10pt}
{\fontsize{11}{13}\selectfont\@author\par}
\vspace{3pt}
{\fontsize{9.5}{11}\selectfont\casetype\color{CaseMuted}\@date\par}
\vspace{12pt}
{\color{CaseRed}\rule{\linewidth}{2pt}\par}
}\endgroup
\vspace{10pt}
}
\makeatother
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{{\fontsize{9}{10}\selectfont\CaseBrand}}
\fancyhead[R]{{\casetype\scriptsize\color{CaseMuted}\CaseNumber}}
\fancyfoot[L]{{\casetype\scriptsize\color{CaseMuted}\CaseShortTitle}}
\fancyfoot[R]{{\casetype\small\bfseries\color{CaseRed}\thepage}}
\renewcommand{\headrulewidth}{1.5pt}
\renewcommand{\footrulewidth}{.9pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{CaseRed}\leaders\hrule height \headrulewidth\hfill}}
\renewcommand{\footrule}{\hbox to\headwidth{\color{CaseBlack}\leaders\hrule height \footrulewidth\hfill}}
\titleformat{\section}{\normalfont\fontsize{14}{16}\selectfont\bfseries\color{CaseBlack}}{\textcolor{CaseRed}{\thesection}}{.7em}{}
\titleformat{\subsection}{\normalfont\fontsize{11.5}{13}\selectfont\bfseries\color{CaseBlack}}{\textcolor{CaseRed}{\thesubsection}}{.65em}{}
\titleformat{\subsubsection}{\normalfont\normalsize\bfseries\color{CaseBlack}}{\thesubsubsection}{.65em}{}
\titlespacing*{\section}{0pt}{1.75ex plus .5ex}{.65ex}
\titlespacing*{\subsection}{0pt}{1.35ex plus .35ex}{.45ex}
\captionsetup{font=small,labelfont={bf,color=CaseBlack},labelsep=period,skip=4pt}
\setlength{\parindent}{1.1em}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{2em}
\linespread{.985}
\setlist[itemize]{leftmargin=*,itemsep=1pt,topsep=3pt,parsep=0pt}
\hypersetup{colorlinks=true,linkcolor=CaseRed,citecolor=CaseRed,urlcolor=CaseRed}
% Strong but editorial: a square red outline and a restrained typewriter label.
\tcbset{caselababstract/.style={
enhanced,breakable,sharp corners,
colback=white,colframe=CaseRed,boxrule=1pt,
left=12pt,right=12pt,top=10pt,bottom=10pt,
before skip=0pt,after skip=14pt,
before upper={\noindent{\casetype\fontsize{9.5}{11}\selectfont\bfseries\color{CaseRed}ABSTRACT}\par\vspace{5pt}\noindent},
fontupper=\small
}}
\renewenvironment{abstract}{\begin{tcolorbox}[caselababstract]}{\end{tcolorbox}}
